                    }
                },
                {
                    "name": "Invoice",
                    "fields": {
                        "invoice_ref": {
                            "type": "string",
                            "required": true
                        }
                    }
                },
                {
                    "name": "Credit",
                    "fields": {}
                }
            ],
            "augments": [
                "immutable",
                "equality"
            ]
        }
    }
